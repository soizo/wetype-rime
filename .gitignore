# Proprietary engines, models, APKs and personal learning data stay local.
.local/
work/
build/
__pycache__/
*.py[cod]
.DS_Store
*.apk
*.bin
*.so
*.dylib
*.bundle/
*.app/

# Diagnostics and future Rime personal dictionaries.
*.log
*.userdb/
*.userdb.txt

# Local collaboration and editor context is not part of the distribution.
AGENTS.md
CLAUDE.md
CONTEXT.md
HANDOFF.md
MEMORY.md
SKILL.md
.agents/
.codex/
.claude/

# Personal configured words must not be published with the source.
/rime/*.txt
/rime/*.dict.yaml
!/rime/wetype.dict.yaml
!/rime/custom.dict.yaml
